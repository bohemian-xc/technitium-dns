# Example environment file for technitium-dns compose
# Copy this to .env and update values before running `docker-compose`.

CONTAINER_NAME=technitium-dns
HOSTNAME=dns-server

# External macvlan network names (must already exist)
APP_NET_NAME=vlan10_net
DHCP_NET_NAME=vlan200_net

# IP addresses on the respective macvlan networks to bind the container to
# Ensure these are free addresses on the target subnet and reachable from your host
APP_NET_IPADDR=192.168.1.94
DHCP_NET_IPADDR=10.2.0.64

# Health settings
HEALTHCHECK_CMD=nslookup google.com 127.0.0.1 >/dev/null 2>&1 && wget -q --spider http://127.0.0.1:5380/ || exit 1
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3


# Optional application settings (uncomment and set in your local .env if needed)
DNS_SERVER_ADMIN_PASSWORD=change_me_secure_password
DNS_SERVER_PREFER_IPV6=false
DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8

# Notes:
# - Do NOT commit a populated .env with secrets; keep secrets out of git.
# - This setup expects macvlan networks that allow the container to receive
#   broadcasts (required for DHCP). See README.md for more details.
